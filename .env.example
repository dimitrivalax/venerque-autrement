# Public Supabase values (bundled into the static site)
# Project origin only — do NOT append /rest/v1 (Edge Functions use /functions/v1/…)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional site URL (metadata / sitemap)
# NEXT_PUBLIC_APP_URL=https://venerque-autrement.fr

# --- Supabase Edge Function secrets (set with `supabase secrets set`, not in Next.js) ---
# SMTP_HOSTNAME=mail.infomaniak.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USERNAME=contact@venerque-autrement.fr
# SMTP_PASSWORD=your-infomaniak-smtp-password
# SMTP_FROM=contact@venerque-autrement.fr
# CONTACT_TO=contact@venerque-autrement.fr
